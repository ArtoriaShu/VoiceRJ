{
  "name": "newvoice",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @newvoice/server dev\" \"pnpm --filter @newvoice/web dev\"",
    "build": "pnpm --filter @newvoice/web build && pnpm --filter @newvoice/server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @newvoice/server test",
    "db:generate": "pnpm --filter @newvoice/server db:generate",
    "db:migrate": "pnpm --filter @newvoice/server db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
